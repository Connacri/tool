{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "android-project/**",
      "assets/**",
      "dist/**",
      "scripts/**",
      "src/**",
      "**/*.sh",
      "**/gradlew",
      "**/gradlew.bat",
      "**/*.keystore",
      "**/*.jks",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "vite.config.ts",
      "capacitor.config.json",
      "server.ts",
      "*.md",
      "**/*.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
