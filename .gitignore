node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example


# Android / Capacitor — le dossier android/ lui-même EST versionné (il contient
# les personnalisations natives : icônes, manifeste, config Gradle), mais pas
# ses artefacts générés à chaque build ni les secrets de signature.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/*.iml
android/.idea/

# Second arbre Gradle historiquement dupliqué, sans rôle : la CI compilait
# uniquement android/, et les copies vers android-project n'étaient jamais
# relues. Supprimé le 2026-10-01 ; l'entrée reste pour qu'un vieux clone ou
# un IDE ne le réimporte pas.
android-project/

# Keystore de signature Play Store — JAMAIS commité (mot de passe + clé
# privée irremplaçable). Voir android/KEYSTORE_README.md pour la procédure.
# Règles globales : un .keystore déposé à la racine par un build local ou
# par un script de release ne doit jamais être rattrapé par git.
keystore.properties
*.keystore
*.jks
android/keystore.properties

# Intermediaires de @capacitor/assets : regeneres depuis public/icon.svg par
# scripts/generate-brand-assets.mjs, pas besoin de les versionner.
assets/icon.png
assets/logo.png
assets/preview-*.png

# Bundle web embarque dans l'APK. C'est un artefact de compilation : il est
# produit par « npm run build:mobile » puis « npx cap sync android » en CI, a
# partir du meme commit que le site publie. Le versionner rendait la copie
# commitee obsolete quelques commits plus tard, sans aucun lien avec le build :
# l'APK construit hors CI partait donc avec le bundle d'un ancien commit.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# IntelliJ / Android Studio
# Seuls les fichiers de configuration de partage (modules.xml, misc.xml,
# markdown.xml) sont versionnes, comme le fait le .gitignore interne a .idea.
# Les caches et l'index local sont propres a chaque poste et changent a chaque
# ouverture : ils ne doivent pas apparaitre dans les diffs.
.idea/caches/
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/tasks.xml
.idea/httpRequests/
.idea/dictionaries/
.idea/libraries/
.idea/deployment/
*.iml
out/
