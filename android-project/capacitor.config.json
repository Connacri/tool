{
  "appId": "com.autopost.studio",
  "appName": "AutoPost Studio",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0a0a0c"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0a0a0c",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
