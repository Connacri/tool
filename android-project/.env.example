# Gemini API Key for server-side phrase & social copy generation
GEMINI_API_KEY=
PORT=3000

# URL publique du serveur (server.ts) une fois déployé (Render, Railway, Fly.io...),
# UNIQUEMENT nécessaire pour le build mobile (npm run build:mobile / cap:sync) — le
# build web classique (npm run build) fonctionne sans, via les chemins relatifs /api/...
# Exemple : VITE_API_BASE_URL=https://autopost-api.exemple.com
VITE_API_BASE_URL=
