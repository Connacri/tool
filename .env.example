GEMINI_API_KEY=
VITE_API_BASE_URL=
# Configuration Publicités (Optionnel - les IDs de test Google sont actifs par défaut)
# ⚠ Les IDs de test ci-dessous ne génèrent AUCUN revenu et sont interdits en
# production par Google. Remplacez-les par vos IDs AdMob avant de publier.
VITE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
# Unité récompensée affichée quand l'utilisateur sauvegarde ou exporte
VITE_ADMOB_REWARDED_ID=
VITE_ADSENSE_CLIENT_ID=

# Firebase Analytics (Optionnel - laisse vide pour builder sans analytics)
# Console Firebase > Project settings > Your apps > SDK setup and configuration > Config
# Ce ne sont pas des secrets : la cle API est publique par conception.
# Seuls ces 3 champs sont obligatoires : VITE_FIREBASE_API_KEY, VITE_FIREBASE_PROJECT_ID, VITE_FIREBASE_APP_ID
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Mettre a false pour couper l'envoi d'evenements sans toucher au code
VITE_FIREBASE_ANALYTICS_ENABLED=true
