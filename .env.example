GEMINI_API_KEY=
PORT=3000
# Modeles Gemini appeles par server.ts, du principal au repli.
# Defauts : gemini-flash-latest / gemini-flash-lite-latest (aliases stables).
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_FALLBACK=
# Google sert des unites distinctes par format, et une unite « Annonce a
# l'ouverture » ne se remplit pas via l'API interstitielle (ni l'inverse) :
# chaque format a donc sa propre variable.
#   VITE_ADMOB_APP_OPEN_ID      -> ca-app-pub-.../XXXXXXXXXX, affichee au lancement
#   VITE_ADMOB_INTERSTITIAL_ID  -> ca-app-pub-.../YYYYYYYYYY, affichee a l'export
# L'App ID (suffixe ~) n'est pas une variable : Android le lit dans le
# AndroidManifest, via com.google.android.gms.ads.APPLICATION_ID.
VITE_ADMOB_APP_OPEN_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADSENSE_CLIENT_ID=
VITE_API_BASE_URL=
VITE_APP_VERSION=
VITE_FIREBASE_ANALYTICS_ENABLED=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_ADSENSE_CLIENT_ID=
VITE_API_BASE_URL=
VITE_APP_VERSION=
VITE_FIREBASE_ANALYTICS_ENABLED=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=