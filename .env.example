# Cle Google AI / Gemini.
# ⚠ Cote SERVEUR uniquement (server.ts). Ne jamais la prefixer par VITE_ :
# toute variable VITE_ est inlinée dans le JavaScript public et deviendrait
# lisible par n'importe quel visiteur. En CI, c'est un secret GitHub.
GEMINI_API_KEY=

# Version affichee dans l'ecran "A propos de".
# En CI elle est injectee automatiquement depuis le tag Git (v1.2.3) par
# scripts/version.mjs : ne pas la renseigner a la main, sauf en local.
VITE_APP_VERSION=

VITE_ADMOB_APP_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=
VITE_ADSENSE_CLIENT_ID=
VITE_API_BASE_URL=
VITE_FIREBASE_ANALYTICS_ENABLED=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=