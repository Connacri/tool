GEMINI_API_KEY=
PORT=3000
# Modeles Gemini appeles par server.ts, du principal au repli.
# Defauts : gemini-flash-latest / gemini-flash-lite-latest (aliases stables).
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_FALLBACK=
# Origines navigateur autorisees a appeler /api, separees par des virgules.
# Les origines Android (capacitor://localhost, https://localhost) et les sites
# GitHub Pages / Firebase sont deja en dur dans server.ts : n'ajouter ici que
# les domaines supplementaires, sinon la page refuse d'appeler l'API.
API_ALLOWED_ORIGINS=
# Google sert des unites distinctes par format, et une unite « Annonce a
# l'ouverture » ne se remplit pas via l'API interstitielle (ni l'inverse) :
# chaque format a donc sa propre variable.
#   VITE_ADMOB_APP_OPEN_ID      -> ca-app-pub-.../XXXXXXXXXX, affichee au lancement
#   VITE_ADMOB_INTERSTITIAL_ID  -> ca-app-pub-.../YYYYYYYYYY, affichee a l'export
# L'App ID (suffixe ~) n'est pas une variable : Android le lit dans le
# AndroidManifest, via com.google.android.gms.ads.APPLICATION_ID.
VITE_ADMOB_APP_OPEN_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADSENSE_CLIENT_ID=
VITE_API_BASE_URL=
VITE_APP_VERSION=

# Firebase — valeurs publiques (non des secrets), depuis la console Firebase >
# Paramètres du projet > Vos applications > Web. VITE_FIREBASE_APP_ID est
# obligatoire pour Performance Monitoring en plus d'Analytics.
# Performance se coupe indépendamment :
#   VITE_FIREBASE_PERFORMANCE_ENABLED=false
VITE_FIREBASE_ANALYTICS_ENABLED=
VITE_FIREBASE_PERFORMANCE_ENABLED=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=